# Copy to terraform.tfvars (git-ignored) and fill in with the values bootstrap.sh prints.
#
# Every value below is a placeholder. Nothing real is ever committed to this repository
# (AGENTS.md). See variables.tf for what each one is for.

tenant_id                = "00000000-0000-0000-0000-000000000000"
platform_subscription_id = "00000000-0000-0000-0000-000000000000"

# Applications and their shared plane. Not eastus/eastus2/northcentralus: SQL provisioning is
# restricted there on this subscription. Check a candidate with
#   az sql db list-editions -l <region> --available
location = "centralus"

# The state account and its key vault stay where bootstrap.sh put them. Held separately so moving
# the applications does not propose moving a locked, purge-protected, state-bearing group.
state_location = "eastus"

state_storage_account_name = "stplatformtfstateexampl"
state_key_vault_name       = "kv-plat-tfstate-EXAMPL"
state_key_vault_uri        = "https://kv-plat-tfstate-EXAMPL.vault.azure.net"


# state_key_name and application_environments have defaults in variables.tf; override only if you
# are running this against a different set of applications.

# Single-subscription slice (P-02 replacement). Environments and application-environments are widened
# deliberately, not automatically — see variables.tf.
active_environments            = ["dev"]
vended_application_environments = ["lemon-dev"]

# From: gh api repos/OWNER/REPO/actions/oidc/customization/sub --jq .sub_claim_prefix
github_repository = "example-org@000000/example-repo@0000000000"
alert_email       = "platform@example.com"
